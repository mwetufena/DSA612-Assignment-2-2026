# --- PostgreSQL (per-service databases) ---
PG_SUPERUSER=postgres
PG_PASSWORD=12345
PG_PORT=5432

# Database names (one per microservice)
DB_CUSTOMER=customer_db
DB_RESTAURANT=restaurant_db
DB_ORDER=order_db
DB_PAYMENT=payment_db
DB_DELIVERY=delivery_db
DB_NOTIFICATION=notification_db
DB_ADMIN=admin_db

# --- Kafka ---
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181
KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:9092,PLAINTEXT_HOST://0.0.0.0:29092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092,PLAINTEXT_HOST://localhost:29092
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true
KAFKA_NUM_PARTITIONS=3

# --- Service ports (host-mapped) ---
PORT_CUSTOMER=8081
PORT_RESTAURANT=8082
PORT_ORDER=8083
PORT_PAYMENT=8084
PORT_DELIVERY=8085
PORT_NOTIFICATION=8086
PORT_ADMIN=8087

# --- GUI ---
GUI_PORT=8080

# --- Cross-service (used inside the compose network) ---
KAFKA_BOOTSTRAP=kafka:9092